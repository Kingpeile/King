<view class="page-container">

  <!-- 指标选择 -->
  <scroll-view class="metric-scroll" scroll-x>
    <view class="metric-tabs">
      <view class="metric-tab {{activeMetric === item.type ? 'active' : ''}}"
            wx:for="{{metricTabs}}" wx:key="type"
            bindtap="switchMetric" data-type="{{item.type}}"
            style="{{activeMetric === item.type ? '--tab-color:'+item.color : ''}}">
        <text class="tab-emoji">{{item.emoji}}</text>
        <text class="tab-name">{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 时间范围 -->
  <view class="range-row">
    <view class="range-btn {{activeRange === item.val ? 'active' : ''}}"
          wx:for="{{ranges}}" wx:key="val"
          bindtap="switchRange" data-val="{{item.val}}">{{item.label}}</view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-row">
    <view class="stat-card card" wx:for="{{stats}}" wx:key="label">
      <text class="stat-value">{{item.value}}</text>
      <text class="stat-label">{{item.label}}</text>
    </view>
  </view>

  <!-- 趋势图（占位，实际用 ec-canvas/ECharts） -->
  <view class="chart-card card">
    <view class="chart-header">
      <text class="chart-title">趋势图</text>
      <text class="chart-range">{{activeRangeLabel}}</text>
    </view>
    <view class="chart-placeholder">
      <view class="chart-bars">
        <view class="chart-bar" wx:for="{{chartBars}}" wx:key="index"
              style="height:{{item.h}}rpx; background:{{item.color}}; opacity:{{item.opacity}}">
        </view>
      </view>
      <view class="chart-labels">
        <text wx:for="{{chartLabels}}" wx:key="index" class="chart-label">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 数据列表 -->
  <view class="section-title">详细数据</view>
  <view class="data-list">
    <view class="data-item card" wx:for="{{dataList}}" wx:key="_id">
      <view class="data-left">
        <view class="data-dot" style="background:{{activeColor}}"></view>
        <view>
          <text class="data-date">{{item.date}}</text>
          <text class="data-note">{{item.note || ''}}</text>
        </view>
      </view>
      <view class="data-right">
        <text class="data-value">{{item.displayValue}}</text>
        <view class="badge badge-{{item.status}}">{{item.statusText}}</view>
      </view>
    </view>
    <view class="empty-hint" wx:if="{{dataList.length === 0}}">
      <text>暂无数据，去记录页添加吧 📊</text>
    </view>
  </view>

</view>
