.metric-scroll {
  white-space: nowrap;
  margin: 32rpx -32rpx 24rpx;
  padding: 0 32rpx;
}
.metric-tabs {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 8rpx;
}
.metric-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 28rpx;
  background: #F5F2EB;
  border-radius: var(--radius-md);
  min-width: 100rpx;
  transition: all 0.2s;
}
.metric-tab.active {
  background: var(--tab-color, var(--color-primary));
}
.tab-emoji { font-size: 36rpx; }
.tab-name {
  font-size: 22rpx;
  color: var(--color-text-light);
}
.metric-tab.active .tab-name { color: var(--color-text); font-weight: 600; }

/* 时间范围 */
.range-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 28rpx;
}
.range-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background: #F5F2EB;
  border-radius: 100rpx;
  font-size: 24rpx;
  color: var(--color-text-light);
}
.range-btn.active {
  background: var(--color-text);
  color: #FFFFFF;
  font-weight: 600;
}

/* 统计卡片 */
.stats-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 16rpx;
}
.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
}
.stat-label {
  font-size: 22rpx;
  color: var(--color-text-light);
}

/* 图表 */
.chart-card { margin-bottom: 40rpx; }
.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}
.chart-title { font-size: 30rpx; font-weight: 700; }
.chart-range { font-size: 24rpx; color: var(--color-text-light); }
.chart-placeholder {
  height: 280rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.chart-bars {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 240rpx;
  padding: 0 8rpx;
}
.chart-bar {
  flex: 1;
  border-radius: 8rpx 8rpx 0 0;
  min-height: 16rpx;
  transition: height 0.4s ease;
}
.chart-labels {
  display: flex;
  justify-content: space-around;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--color-border);
}
.chart-label { font-size: 20rpx; color: var(--color-text-light); }

/* 数据列表 */
.section-title { font-size: 32rpx; font-weight: 700; margin-bottom: 24rpx; }
.data-list { display: flex; flex-direction: column; gap: 16rpx; }
.data-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}
.data-left { display: flex; align-items: center; gap: 20rpx; }
.data-dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; }
.data-date { display: block; font-size: 28rpx; font-weight: 600; }
.data-note { display: block; font-size: 22rpx; color: var(--color-text-light); margin-top: 4rpx; }
.data-right { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.data-value { font-size: 30rpx; font-weight: 700; }
.empty-hint { text-align: center; padding: 80rpx 0; color: var(--color-text-light); font-size: 28rpx; }
