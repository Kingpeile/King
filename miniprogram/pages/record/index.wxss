.type-scroll {
  white-space: nowrap;
  margin: 32rpx -32rpx 32rpx;
  padding: 0 32rpx;
}
.type-list {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 8rpx;
}
.type-chip {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 28rpx;
  background: #F5F2EB;
  border-radius: 100rpx;
  font-size: 26rpx;
  color: var(--color-text-light);
  white-space: nowrap;
  transition: all 0.2s;
}
.type-chip.active {
  color: var(--color-text);
  font-weight: 600;
}

.form-card { margin-bottom: 40rpx; }
.form-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 24rpx;
}
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 8rpx 0;
}
.form-row-col {
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}
.form-label {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
}
.form-value-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.form-value {
  font-size: 28rpx;
  color: var(--color-text-light);
}
.form-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
}
.form-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.form-input {
  text-align: right;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  min-width: 120rpx;
}
.form-unit {
  font-size: 24rpx;
  color: var(--color-text-light);
}
.form-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 26rpx;
  color: var(--color-text);
  background: #F9F7F2;
  border-radius: var(--radius-sm);
  padding: 20rpx;
  box-sizing: border-box;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.history-list { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 120rpx; }
.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}
.history-date {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}
.history-note {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-light);
  margin-top: 4rpx;
}
.history-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.history-value {
  font-size: 32rpx;
  font-weight: 700;
}
.empty-hint {
  text-align: center;
  padding: 80rpx 0;
  color: var(--color-text-light);
  font-size: 28rpx;
}

.save-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 48rpx;
  background: rgba(255,253,245,0.95);
  backdrop-filter: blur(20px);
}
.save-btn { width: 100%; }
