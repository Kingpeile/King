/* 顶部 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 48rpx 0 32rpx;
}
.greeting {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-light);
}
.username {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-top: 4rpx;
}
.avatar-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid var(--color-yellow);
}
.avatar { width: 100%; height: 100%; }

/* 健康评分卡 */
.score-card {
  background: linear-gradient(135deg, #FFF5EE 0%, #FFFDF5 100%);
  margin-bottom: 40rpx;
}
.score-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.score-label {
  font-size: 26rpx;
  color: var(--color-text-light);
}
.score-date {
  font-size: 22rpx;
  color: #BBBBBB;
  margin-top: 6rpx;
}
.score-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.score-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}
.score-unit {
  font-size: 20rpx;
  color: rgba(255,255,255,0.8);
}
.score-bar-bg {
  height: 16rpx;
  background: #F0EDE6;
  border-radius: 100rpx;
  overflow: hidden;
}
.score-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-yellow), var(--color-primary));
  border-radius: 100rpx;
  transition: width 0.6s ease;
}
.score-tip {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-light);
  margin-top: 16rpx;
}

/* section标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  margin: 8rpx 0 24rpx;
}

/* 快捷记录 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}
.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.quick-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
}
.quick-emoji { font-size: 44rpx; }
.quick-name {
  font-size: 22rpx;
  color: var(--color-text-light);
}
.quick-value {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* 指标列表 */
.metrics-list { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 40rpx; }
.metric-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}
.metric-left { display: flex; align-items: center; gap: 20rpx; }
.metric-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.metric-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}
.metric-date {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-light);
  margin-top: 4rpx;
}
.metric-right { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.metric-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
}
.metric-unit { font-size: 20rpx; font-weight: 400; color: var(--color-text-light); margin-left: 4rpx; }

/* 体检提醒 */
.remind-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #FFF9E6, #FFFDF5);
}
.remind-icon { font-size: 48rpx; }
.remind-content { flex: 1; }
.remind-title {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-light);
}
.remind-days {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-top: 4rpx;
}
.remind-arrow {
  font-size: 40rpx;
  color: var(--color-text-light);
}
