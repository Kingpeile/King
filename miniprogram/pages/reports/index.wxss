.summary-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 28rpx;
  padding-top: 32rpx;
}
.summary-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 28rpx 16rpx;
}
.summary-num { font-size: 40rpx; font-weight: 700; color: var(--color-text); }
.summary-label { font-size: 22rpx; color: var(--color-text-light); }

.upload-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #F0F8FF, #FFFDF5);
  border: 2rpx dashed #B5D4EA;
}
.upload-icon { font-size: 56rpx; }
.upload-text { flex: 1; }
.upload-title { display: block; font-size: 28rpx; font-weight: 600; }
.upload-sub { display: block; font-size: 22rpx; color: var(--color-text-light); margin-top: 4rpx; }
.upload-btn {
  background: var(--color-blue, #B5D4EA);
  color: var(--color-text);
  padding: 16rpx 28rpx;
  border-radius: 100rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.section-title { font-size: 32rpx; font-weight: 700; margin-bottom: 24rpx; }

.report-list { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 40rpx; }
.report-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
}
.report-left { display: flex; align-items: center; gap: 24rpx; }
.report-year-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.report-year { font-size: 24rpx; font-weight: 700; color: #FFFFFF; }
.report-title { display: block; font-size: 28rpx; font-weight: 600; }
.report-date { display: block; font-size: 22rpx; color: var(--color-text-light); margin-top: 4rpx; }
.report-right { display: flex; align-items: center; gap: 16rpx; }
.report-alert {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFE8E8;
  border-radius: var(--radius-sm);
  padding: 8rpx 16rpx;
}
.report-alert-num { font-size: 28rpx; font-weight: 700; color: #E74C3C; }
.report-alert-text { font-size: 18rpx; color: #E74C3C; }
.report-ok { color: #2ECC71; font-size: 24rpx; font-weight: 600; }
.report-arrow { font-size: 40rpx; color: #CCCCCC; }

.empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 16rpx;
}
.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 28rpx; color: var(--color-text-light); }

/* 关键指标 */
.key-metrics { display: flex; flex-direction: column; gap: 20rpx; }
.key-metric-card { padding: 28rpx; }
.km-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.km-name { font-size: 28rpx; font-weight: 600; }
.km-values { display: flex; flex-direction: column; gap: 16rpx; }
.km-year { display: flex; align-items: center; gap: 16rpx; }
.km-yr { font-size: 22rpx; color: var(--color-text-light); width: 80rpx; }
.km-bar-bg { flex: 1; height: 16rpx; background: #F0EDE6; border-radius: 100rpx; overflow: hidden; }
.km-bar { height: 100%; border-radius: 100rpx; transition: width 0.4s ease; }
.km-val { font-size: 24rpx; font-weight: 600; width: 100rpx; text-align: right; }
